# CrossNotify Server Configuration
# Only infrastructure variables live here. Everything else is configured in the web dashboard.

PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Master encryption key (Base64 32 bytes)
# If unset, the server auto-generates DATA_DIR/secret.key with 0600 permissions.
# CROSSNOTIFY_SECRET=

# Optional pre-set setup token for headless/automated deployment.
# If unset, a random one is generated and printed in the server logs on first boot.
# CROSSNOTIFY_SETUP_TOKEN=

# Reverse proxy support (set to 1 behind Caddy, Nginx, Cloudflare)
TRUST_PROXY=false

# Session cookie security: 'auto' (default, secure if req.secure), 'true', or 'false'
COOKIE_SECURE=auto

# Logging level: debug | info | warn | error
LOG_LEVEL=info
